# Copy to .env and fill in. Everything is optional.

# Company name shown in the app, proposals and DXF title block
BARNDO_COMPANY_NAME=ES Barndominiums

# Claude API key - turns on AI intake ("describe your barndo") and AI plan descriptions.
# Without it the app uses the built-in rule-based parser and template text.
ANTHROPIC_API_KEY=
# Model used for intake / descriptions
BARNDO_AI_MODEL=claude-opus-5-5

# Protects /api/admin/* (lead export, rulebook reload, module check)
BARNDO_ADMIN_TOKEN=change-me

# POST each new lead as JSON to your CRM / Zapier / Make / HubSpot webhook
BARNDO_LEAD_WEBHOOK_URL=

# Path to ODA File Converter executable for DWG export (free from opendesign.com)
ODA_FILE_CONVERTER=
